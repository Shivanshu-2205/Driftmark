# ==========================================
# DriftWatch Environment Variables Template
# ==========================================

# Backend API Port
PORT=8000

# MongoDB Connection URI
# - Local development: mongodb://localhost:27017
# - Docker Compose: mongodb://mongodb:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=driftwatch_db

# File Storage
DATA_DIR=./backend/data
MODELS_DIR=./backend/models

# Authentication
JWT_SECRET=driftwatch-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400

# Frontend Next.js API Base
NEXT_PUBLIC_API_BASE=http://localhost:8000
