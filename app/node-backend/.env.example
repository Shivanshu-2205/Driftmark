# Node control-layer server
PORT=8000

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=driftwatch_db

# Python ML layer (internal service, not exposed publicly)
ML_SERVICE_URL=http://localhost:8001

# Storage
DATA_DIR=./data
MODELS_DIR=./models

# Auth
JWT_SECRET=driftwatch-jwt-secret-key-change-in-production
JWT_EXPIRATION_SECONDS=86400
